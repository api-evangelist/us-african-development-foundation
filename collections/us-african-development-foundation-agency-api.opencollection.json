{
  "opencollection": "1.0.0",
  "info": {
    "name": "USADF Grant Opportunities Agency API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Agency",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "USADF Get Agency Award Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apply07.grants.gov/grantsws/rest/api/v2/agency/166/awards/",
            "params": [
              {
                "name": "fiscal_year",
                "value": "2023",
                "type": "query",
                "description": "Fiscal year for the summary"
              },
              {
                "name": "award_type_codes",
                "value": "02,03,04",
                "type": "query",
                "description": "Comma-separated award type codes (02=Block Grant, 03=Formula Grant, 04=Project Grant)"
              }
            ]
          },
          "docs": "Retrieve a summary of USADF grant award activity for a given fiscal year, including total obligations, number of awards, and breakdown by award type."
        }
      ]
    }
  ],
  "bundled": true
}