{
  "opencollection": "1.0.0",
  "info": {
    "name": "USADF Grant Opportunities Agency Awards API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Awards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "USADF Search Grant Awards",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apply07.grants.gov/grantsws/rest/api/v2/search/spending_by_award/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for USADF grant awards using the USASpending API. Filter by award type, recipient country, time period, and other criteria. Use agencies filter with USADF toptier_code \"166\" to retrieve USADF awards."
        },
        {
          "info": {
            "name": "USADF Get Award Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apply07.grants.gov/grantsws/rest/api/v2/awards/:award_id/",
            "params": [
              {
                "name": "award_id",
                "value": "ASST_NON_166GH21LE0001",
                "type": "path",
                "description": "USASpending award identifier"
              }
            ]
          },
          "docs": "Retrieve detailed information for a specific USADF grant award by its USASpending award identifier. Returns full award details including recipient, place of performance, funding agency, and transaction history."
        }
      ]
    }
  ],
  "bundled": true
}