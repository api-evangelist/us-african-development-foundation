          "name": "USADF Search Grant Awards",
          "request": {
            "name": "USADF Search Grant Awards",
            "description": {
              "content": "Search for USADF grant awards using the USASpending API. Filter by award type, recipient country, time period, and other criteria. Use agencies filter with USADF toptier_code \"166\" to retrieve USADF awards.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "search",
                "spending_by_award",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"agencies\": [\n      {\n        \"type\": \"<string>\",\n        \"tier\": \"<string>\",\n        \"name\": \"<string>\"\n      },\n      {\n        \"type\": \"<string>\",\n        \"tier\": \"<string>\",\n        \"name\": \"<string>\"\n      }\n    ],\n    \"award_type_codes\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"time_period\": [\n      {\n        \"start_date\": \"<date>\",\n        \"end_date\": \"<date>\"\n      },\n      {\n        \"start_date\": \"<date>\",\n        \"end_date\": \"<date>\"\n      }\n    ]\n  },\n  \"fields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"limit\": \"<integer>\",\n  \"page\": \"<integer>\",\n  \"sort\": \"<string>\",\n  \"order\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
